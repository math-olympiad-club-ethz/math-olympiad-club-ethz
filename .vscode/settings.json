// Math Olympiad Club ETHZ — LaTeX authoring settings for the problem bank.
// Live preview: saving a problem (problem-bank/problems/NNNN-title.tex or new-title.tex), a shared result
// (problem-bank/appendix/<name>.tex) or a seminar sheet file (problem-bank/seminar_antoine_problems_solutions/
// <sheet>/<name>.tex, local only) compiles it through problem-bank/problems/_preview.tex (shared preamble, cited
// results); the PDF appears next to the .tex (git-ignored). Open that PDF once from the Explorer: it refreshes after
// every save, and Cmd-click in it jumps to the source.
// These files have no \documentclass, so LaTeX Workshop finds no "root file" for them and its recipes never run:
// the build is the external command .vscode/bank-preview.sh, which compiles the .tex saved last (any other .tex,
// e.g. statutes.tex or preamble.tex, is left alone).
// Requires the "LaTeX Workshop" extension (see .vscode/extensions.json).
{
  // Runs from the workspace folder on every save of a .tex (autoBuild onSave below).
  "latex-workshop.latex.external.build.command": "/bin/sh",
  "latex-workshop.latex.external.build.args": [".vscode/bank-preview.sh"],
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "onBuilt",
  // After each build, delete the aux junk but KEEP *.synctex.gz (powers ⌘-click
  // jump, both directions) and the .pdf (bank-preview.sh does the same). Each folder
  // keeps just .tex + .pdf + .synctex.gz, and the .synctex.gz is hidden in the
  // Explorer (files.exclude below): it stays on disk, so the jump still works.
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.bcf", "*.blg", "*.fdb_latexmk", "*.fls",
    "*.log", "*.out", "*.run.xml",
    "*.toc", "*.lof", "*.lot", "*.nav", "*.snm", "*.vrb",
    "*.idx", "*.ind", "*.ilg", "*.xdv"
  ],
  // Use the explicit list above (default 'latexmk -c' refuses to delete .bbl).
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.view.pdf.viewer": "tab",
  // After each build, jump the PDF to wherever your cursor is — automatic
  // forward-sync, so you rarely need to press the shortcut yourself.
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.message.update.show": false,
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,

  // Hide the SyncTeX files of the previews in the Explorer (VS Code's default exclusions kept).
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.synctex.gz": true
  },

  // Lets a plain `latexmk` in the VS Code integrated terminal also find the
  // shared preamble.tex / references.bib in problem-bank/.
  "terminal.integrated.env.osx": {
    "TEXINPUTS": "${workspaceFolder}/problem-bank:",
    "BIBINPUTS": "${workspaceFolder}/problem-bank:"
  }
}
