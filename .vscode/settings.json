// Math Olympiad Club at ETHZ — LaTeX authoring settings for the problem bank.
// Live preview: saving one of four kinds of files compiles it through problem-bank/problems/_preview.tex (shared
// preamble, cited results):
//   - a problem (problem-bank/problems/NNNN-title.tex or new-title.tex);
//   - a shared result (problem-bank/appendix/<name>.tex);
//   - a seminar sheet file (problem-bank/seminar_antoine_problems_solutions/<sheet>/<name>.tex, local only);
//   - a staged problem of the seminar repository (problem-bank/topics-in-competition-seminar/<group>/<sheet>/<name>.tex,
//     local only).
// The PDF appears next to the .tex (git-ignored). Open that PDF once from the Explorer: it refreshes after every save,
// and Cmd-click in it jumps to the source.
// These files have no \documentclass, so LaTeX Workshop finds no "root file" for them and its recipes never run:
// the build is the external command .vscode/bank-preview.sh, which compiles the .tex saved last (any other .tex,
// e.g. statutes.tex or preamble.tex, is left alone).
// Requires the "LaTeX Workshop" extension (see .vscode/extensions.json).
{
  // Runs from the workspace folder on every save of a .tex (autoBuild onSave below).
  "latex-workshop.latex.external.build.command": "/bin/sh",
  "latex-workshop.latex.external.build.args": [".vscode/bank-preview.sh"],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.message.update.show": false,
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,

  // bank-preview.sh deletes the auxiliary files itself after each build: a folder keeps the .tex, the .pdf and the
  // .synctex.gz (which powers the Cmd-click jump from the PDF). The .synctex.gz stays on disk and is hidden in the
  // Explorer (VS Code's default exclusions kept).
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.synctex.gz": true
  },

  // Lets a plain `latexmk` in the VS Code integrated terminal also find the
  // shared preamble.tex / references.bib in problem-bank/.
  "terminal.integrated.env.osx": {
    "TEXINPUTS": "${workspaceFolder}/problem-bank:",
    "BIBINPUTS": "${workspaceFolder}/problem-bank:"
  }
}
