.DS_Store
venv/
__pycache__/
*.pyc

# LaTeX auxiliary files — keep the .tex sources and the compiled .pdf, ignore the rest.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.bcf
*.blg
*.run.xml
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.xdv
*.dvi

# Personal inspiration / working material — kept local per person, never committed.
# (Holds the ~55 MB reference library and problem_collection.tex notes, under problem-bank/inspiration/.)
/problem-bank/inspiration/*
!/problem-bank/inspiration/README.md

# Problems still in construction (e.g. the magic problems) — kept local, never committed.
# Finished problems move to problem-bank/problems/. Only the README is tracked.
/problem-bank/work-in-progress/*
!/problem-bank/work-in-progress/README.md

# Antoine's scanned seminar sheets ("Topics in Competition Mathematics", ETH) and their transcription — kept local, never committed.
/problem-bank/seminar_antoine_problems_solutions/

# The seminar repo's problems (Topics in Competition Mathematics) with the students' solutions: staging, kept local.
/problem-bank/topics-in-competition-seminar/

# Personal Claude Code instructions — local only, never committed.
CLAUDE.local.md

# Node test toolchain (Playwright, for the browser tests)
node_modules/

# Build products of website-code/tools/busytex_bundle.py (regenerated in CI) and the figure cache of bank/stitch.py
website-code/site/static/busytex/
.cache/

# LaTeX Workshop save-error leftovers
*-SAVE-ERROR

# Problem-bank build outputs (regenerated by website-code/build.py in CI)
website-code/site/static/bank/

# The pages themselves: website-code/build.py renders templates/ into site/ and CI deploys ITS OWN copies,
# so a committed copy is never the one served — it only goes stale (and `npm test` leaves a preview build here).
website-code/site/*.html

# Local previews of single problems (problem-bank/problems/_preview.tex via VS Code), and any stray PDF compiled from
# a file in problem-bank/ itself (e.g. preamble.tex)
problem-bank/problems/*.pdf
problem-bank/appendix/*.pdf
problem-bank/*.pdf
